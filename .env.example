# Copy to .env and fill in. Never commit .env.
# Docker Compose passes these to the container. Outside Docker, export them first:
#   set -a; . ./.env; set +a

# --- Devin (API v3) ---
# Service user token (starts with cog_) or personal access token with
# permission to manage org sessions.
DEVIN_API_KEY=
# Organization ID, e.g. org-xxxxxxxx
DEVIN_ORG_ID=

# --- Target ---
# The fork the automation acts on: events from any other repository are ignored.
TARGET_REPO=sruthikilari/superset

# --- Optional (these are the defaults) ---
# Per-session usage cap sent to Devin.
MAX_ACU_LIMIT=15
# A run still going after this many minutes is marked timed_out (its session is left open).
MAX_RUN_MINUTES=60
POLL_INTERVAL_SECONDS=30
DATABASE_PATH=./data/remediations.db
